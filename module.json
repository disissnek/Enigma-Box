{
  "id": "enigma-box",
  "title": "Enigma Box",
  "version": "1.0.0",
  "compatibility": {
    "minimum": "12",
    "verified": "14"
  },
  "socket": true,
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/style.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Russian",
      "path": "lang/ru.json"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module"
      }
    ]
  }
}