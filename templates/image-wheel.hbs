<div class="puzzle-inner-content">
    <h1>{{docName}}</h1>
    {{#if description}}<p class="enigma-desc">{{{description}}}</p>{{/if}}

    <div class="enigma-wheel-container" style="background-image: url('{{{bgImg}}}');">
        {{#each rings as |ring|}}
            <div class="enigma-ring" data-id="{{ring.id}}" style="background-image: url('{{{../wheelImg}}}'); transform: rotate({{ring.rot}}deg); z-index: {{ring.z}}; -webkit-mask-image: {{ring.mask}}; mask-image: {{ring.mask}};"></div>
        {{/each}}
    </div>
</div>