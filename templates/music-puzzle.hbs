<div class="puzzle-inner-content">
    <h1>{{docName}}</h1>
    {{#if description}}<p class="enigma-desc">{{{description}}}</p>{{/if}}

    <div class="music-controls">
        <button type="button" class="play-melody-btn">
            <i class="fas fa-volume-up"></i> {{playMelodyLabel}}
        </button>
    </div>

    <div class="enigma-music-board">
        {{#each buttons as |btn|}}
            <div class="music-btn" data-id="{{btn.id}}"></div>
        {{/each}}
    </div>
</div>