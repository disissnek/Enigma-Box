<div class="puzzle-inner-content">
    <h1>{{docName}}</h1>
    {{#if description}}<p class="enigma-desc">{{{description}}}</p>{{/if}}

    <div class="enigma-cryptex-wrapper">
        <div class="cryptex-bracket left" style="background-image: url('{{{bracketImg}}}');"></div>
        <div class="cryptex-center" style="background-image: url('{{{bgImg}}}');">
            {{#each cylinders as |cyl|}}
                <div class="cryptex-cyl" data-id="{{cyl.id}}">
                    <div class="cyl-content">
                        {{#if cyl.isImg}}
                            <img src="{{{cyl.symbol}}}" style="max-width:80%; max-height:80%; border:none; box-shadow:none;">
                        {{else}}
                            <span>{{cyl.symbol}}</span>
                        {{/if}}
                    </div>
                    <div class="cyl-highlight"></div>
                </div>
            {{/each}}
        </div>
        <div class="cryptex-bracket right" style="background-image: url('{{{bracketImg}}}');"></div>
    </div>
</div>