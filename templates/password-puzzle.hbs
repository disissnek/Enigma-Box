<div class="puzzle-inner-content">
    <h1>{{docName}}</h1>
    {{#if description}}<p class="enigma-desc">{{{description}}}</p>{{/if}}

    <div class="enigma-password-board" style="background-image: url('{{{keypadBg}}}');">
        <div class="pass-display"><span class="pass-display-text">{{currentInput}}</span></div>
        <div class="pass-back" title="Стереть"></div>

        <div class="pass-keypad">
            {{#each keys as |k|}}
                <div class="pass-key {{#if k.isZero}}key-zero{{/if}}" data-key="{{k.val}}" style="background-image: url('{{{../keyBtnBg}}}');">
                    {{#if k.hasImg}}
                        <img src="{{{k.img}}}" alt="{{k.val}}">
                    {{else}}
                        <span>{{k.val}}</span>
                    {{/if}}
                </div>
            {{/each}}
        </div>
    </div>
</div>