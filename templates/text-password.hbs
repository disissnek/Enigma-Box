<div class="puzzle-inner-content">
    <h1>{{docName}}</h1>
    {{#if description}}<p class="enigma-desc">{{{description}}}</p>{{/if}}

    <div class="enigma-text-password-board" style="background-image: url('{{{panelBg}}}');">
        <input type="text" class="text-pass-input" placeholder="{{passPlaceholder}}" autocomplete="off" spellcheck="false">
        <div class="text-pass-clear" title="{{clearTitle}}"></div>
        <div class="text-pass-submit" title="{{submitTitle}}"></div>
    </div>
</div>