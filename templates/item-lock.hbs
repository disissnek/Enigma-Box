<div class="puzzle-inner-content">
    <h1>{{docName}}</h1>
    {{#if description}}<p class="enigma-desc">{{{description}}}</p>{{/if}}

    <div class="enigma-slot-container">
        {{#each slots as |slot|}}
            <div class="enigma-slot" data-id="{{slot.id}}" title="{{#if slot.item}}{{slot.item.title}}{{else}}{{../emptySlotTitle}}{{/if}}">
                {{#if slot.item}}
                    <img class="slot-item-img" src="{{{slot.item.img}}}" alt="{{slot.item.name}}">
                {{/if}}
            </div>
        {{/each}}
    </div>
</div>