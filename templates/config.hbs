<form autocomplete="off">
    <div class="form-group">
        <label>{{labels.enable}}</label>
        <input type="checkbox" name="isActive" {{checked config.isActive}}>
    </div>

    <div class="form-group">
        <label>{{labels.type}}</label>
        <select name="type">
            {{#each puzzleTypes as |pt|}}
                <option value="{{pt.value}}" {{#if pt.selected}}selected{{/if}}>{{pt.label}}</option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label>{{labels.customTitle}}</label>
        <input type="text" name="customTitle" value="{{config.customTitle}}" placeholder="{{labels.customTitlePlaceholder}}">
    </div>

    <div class="form-group stacked">
        <label>{{labels.description}}</label>
        <textarea name="description" rows="3" placeholder="{{labels.descriptionPlaceholder}}">{{config.description}}</textarea>
    </div>

    <div class="form-group">
        <label>{{labels.successTile}}</label>
        <input type="text" name="successTileId" value="{{config.successTileId}}" placeholder="{{labels.successTilePlaceholder}}">
    </div>

    <hr>
    <h3>{{labels.puzzleSection}}</h3>

    {{#each inputs as |input|}}
        <div class="form-group">
            <label>{{input.label}}</label>
            {{#if (eq input.type 'text')}}<input type="text" name="{{input.name}}" value="{{input.value}}">{{/if}}
            {{#if (eq input.type 'number')}}<input type="number" name="{{input.name}}" value="{{input.value}}" min="{{input.min}}" max="{{input.max}}">{{/if}}
            {{#if (eq input.type 'filepicker')}}
                <div class="form-fields">
                    {{filePicker target=input.name type="imagevideo"}}
                    <input class="image" type="text" name="{{input.name}}" value="{{input.value}}">
                </div>
            {{/if}}
            {{#if (eq input.type 'audiopicker')}}
                <div class="form-fields">
                    {{filePicker target=input.name type="audio"}}
                    <input class="audio" type="text" name="{{input.name}}" value="{{input.value}}">
                </div>
            {{/if}}
        </div>
    {{/each}}

    <button type="submit" style="margin-top: 15px;"><i class="fas fa-save"></i> {{labels.save}}</button>
</form>