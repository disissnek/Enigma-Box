{
  "name": "enigma-box",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run check:syntax && npm run check:manifest",
    "check:syntax": "find scripts -name '*.js' -print0 | xargs -0 -n 1 node --check",
